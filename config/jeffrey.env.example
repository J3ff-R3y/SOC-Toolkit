# Jeffrey Toolkit deployment variables
#
# Copy this file to a deployment-specific location.
# Do NOT commit production secrets or environment-specific credentials.
#
# These are examples. Adapt them to the target host.

MODEL_PATH=/data/models/model.gguf
MMPROJ_PATH=/data/models/mmproj.gguf

LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081

# Reference values only. Benchmark on the target hardware.
LLAMA_CTX_SIZE=32768
LLAMA_THREADS=16
LLAMA_BATCH_SIZE=1024
LLAMA_UBATCH_SIZE=2048

TOOLKIT_ROOT=/data/toolkit
LOG_FILE=/var/log/llama-server.log
