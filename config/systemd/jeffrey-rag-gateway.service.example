[Unit]
Description=Jeffrey local RAG gateway
After=network.target jeffrey-gateway.service
Requires=jeffrey-gateway.service

[Service]
Type=simple
User=jeffrey-gateway
Group=jeffrey-gateway
WorkingDirectory=/opt/jeffrey-rag
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/jeffrey-rag/bin/rag_gateway.py --config /etc/jeffrey-rag/rag-gateway.json
Restart=on-failure
RestartSec=2
UMask=0007

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/jeffrey-rag
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
